#!/bin/sh
# Auto cache-busting: re-stamp ?v=<hash> on css/js references before every commit,
# then re-stage the HTML pages if the stamps changed. Never lets a stale-cache
# slip through. See tools/stamp-assets.js.

node tools/stamp-assets.js >/dev/null 2>&1 || {
  echo "stamp-assets.js failed — commit aborted"; exit 1;
}

# Hide/show the footer link to the transparency notice depending on whether
# its invoice placeholders are still unresolved. See tools/sync-transparency-visibility.js.
node tools/sync-transparency-visibility.js >/dev/null 2>&1 || {
  echo "sync-transparency-visibility.js failed — commit aborted"; exit 1;
}

# Re-stage the HTML pages so the refreshed stamps/visibility are part of this commit
git add index.html pexeso/index.html transparentnost/index.html

exit 0
